# 环境变量（必须排除，防止泄露密钥）
.env
.env.*

# 大型模型文件和数据文件
*.bin
*.safetensors
*.onnx
model/
chroma_db/
data/
*.sqlite3

# 巨大的外部软件或特定输出目录（根据你的截图）
software/
onnx/
other/

# 运行输出和缓存
cache/
output/
logs/
*.log

# Python 运行缓存
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# 虚拟环境
.venv/
venv/

# 测试和检查工具缓存
.mypy_cache/
.pytest_cache/
